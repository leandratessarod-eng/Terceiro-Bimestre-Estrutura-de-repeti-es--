programa 
{
  funcao inicio() 
  {
      inteiro numero
      inteiro pares = 0 
      inteiro impares = 0 

      para (inteiro i = 1; i <= 5; i ++)
      { 
          escreva("Digite um numero inteiro: ")
          leia(numero) 

          se (numero % 2 == 0)
          { 
            pares = pares + 1 
          }
          senao
          { 
            impares = impares + 1

     }         
  }
      escreva("Quantidade de numeros pares: ", pares, "\n")

      escreva("Quantidade de numeros impares: ", impares)
      }
   }   

